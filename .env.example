# ==============================================================================
# Search Algorithm Visualizer - Environment Configuration Template
# Copy this file to '.env' for local development or set these variables in your
# hosting provider (Vercel, Render, Railway, Fly.io, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'development' locally or 'production' when deploying
ENVIRONMENT=development

# Server bind settings
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Local Development (Default SQLite)
DATABASE_URL=sqlite:///./visualizer.db

# Option B: Neon PostgreSQL (Recommended for Production & Vercel)
# You can use the variable name 'NEON' or 'DATABASE_URL' interchangeably:
# NEON=postgresql://username:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql+psycopg://username:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Database Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ------------------------------------------------------------------------------
# 3. CORS & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
# In production, replace with your actual frontend domain(s)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Regular expression pattern to allow all Vercel preview branch deployments automatically
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# ------------------------------------------------------------------------------
# 4. FRONTEND BUILD CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# Leave empty when using Vite's local dev proxy or Vercel transparent rewrites.
# Set only if your frontend is deployed separately and must call the backend directly:
# VITE_API_URL=https://your-backend-api.onrender.com
VITE_API_URL=
